{
  "version": 1,
  "servers": [
    {
      "id": "typescript",
      "enabled": true,
      "include": [
        "frontend/**/*.ts",
        "frontend/**/*.tsx",
        "frontend/**/*.js",
        "frontend/**/*.jsx"
      ],
      "exclude": [
        "**/node_modules/**",
        "**/dist/**",
        "**/build/**"
      ],
      "rootMarkers": [
        "package.json",
        "tsconfig.json"
      ],
      "bin": "npx",
      "args": [
        "--yes",
        "typescript-language-server",
        "--stdio"
      ],
      "cwd": "{root}",
      "languageIdByExtension": {
        ".ts": "typescript",
        ".tsx": "typescriptreact",
        ".js": "javascript",
        ".jsx": "javascriptreact"
      },
      "startupTimeoutMs": 45000,
      "diagnosticsWaitMs": 2000,
      "initializationOptions": {},
      "settings": {}
    },
    {
      "id": "gopls",
      "enabled": true,
      "include": [
        "backend/**/*.go"
      ],
      "exclude": [
        "**/vendor/**"
      ],
      "rootMarkers": [
        "go.mod",
        "go.work"
      ],
      "bin": "/home/kd/go/bin/gopls",
      "args": [],
      "cwd": "{root}",
      "languageIdByExtension": {
        ".go": "go"
      },
      "startupTimeoutMs": 45000,
      "diagnosticsWaitMs": 1500,
      "initializationOptions": {},
      "settings": {}
    }
  ]
}
